#!/bin/sh
# Run the installed sigrok-cli with the libsigrok from tools/build-dev.sh.
#   tools/sigrok-cli-gla -d gusmanb-logicanalyzer:conn=/dev/ttyACM0 --scan
PREFIX=${PREFIX:-$HOME/.local/sigrok}
LD_LIBRARY_PATH=$PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH} \
PYTHONWARNINGS=${PYTHONWARNINGS:-ignore} exec sigrok-cli "$@"
